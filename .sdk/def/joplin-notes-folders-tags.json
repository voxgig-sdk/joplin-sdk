          }
        }
      }
    },
    "/folders/{id}/notes": {
      "get": {
        "tags": [
          "folder"
        ],
        "summary": "Get the notes in this folder.",
        "operationId": "listFolderNotes",
        "parameters": [
          {
            "$ref": "#/components/parameters/id"
          },
          {
            "$ref": "#/components/parameters/fields"
          }
        ],
        "responses": {
          "200": {
            "description": "The item.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Note"
                      }
                    },
                    "has_more": {
                      "type": "boolean",
                      "description": "True when a further page is available; pass the next page number."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/tags": {
      "get": {
        "tags": [
