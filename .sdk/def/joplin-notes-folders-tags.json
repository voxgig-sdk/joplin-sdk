  },
  "components": {
    "securitySchemes": {
      "token": {
        "type": "apiKey",
        "in": "query",
        "name": "token",
        "description": "The Web Clipper authorisation token, shown in Joplin under Options, Web Clipper."
      }
    },
    "parameters": {
      "id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "The item ID."
      },
      "note_id": {
        "name": "note_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "The note ID."
      },
      "fields": {
        "name": "fields",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Comma-separated list of properties to return. Request only what you need."
      },
      "page": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "default": 1
        },
        "description": "1-based page number. Read has_more to know whether to ask for the next."
      },
      "order_by": {
        "name": "order_by",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Property to sort by, for example updated_time."
      },
      "order_dir": {
        "name": "order_dir",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "ASC",
            "DESC"
          ]
        },
        "description": "Sort direction."
      }
    },
    "responses": {
      "NotFound": {
        "description": "No item with that ID."
      }
    },
    "schemas": {
      "Note": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "parent_id": {
            "type": "string",
            "description": "ID of the notebook that contains this note. Change this ID to move the note to a different notebook."
          },
          "title": {
            "type": "string",
            "description": "The note title."
          },
          "body": {
            "type": "string",
            "description": "The note body, in Markdown. May also contain HTML."
          },
          "created_time": {
            "type": "integer",
            "description": "When the note was created."
          },
          "updated_time": {
            "type": "integer",
            "description": "When the note was last updated."
          },
          "is_conflict": {
            "type": "integer",
            "description": "Tells whether the note is a conflict or not."
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "altitude": {
            "type": "number"
          },
          "author": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "description": "The full URL where the note comes from."
          },
          "is_todo": {
            "type": "integer",
            "description": "Tells whether this note is a to-do or not."
          },
          "todo_due": {
            "type": "integer",
            "description": "When the to-do is due."
          },
          "todo_completed": {
            "type": "integer",
            "description": "When the to-do was completed."
          },
          "markup_language": {
            "type": "integer",
            "description": "1 for Markdown, 2 for HTML."
          },
          "user_created_time": {
            "type": "integer",
            "description": "When the note was created. May differ from created_time as the user can set it."
          },
          "user_updated_time": {
            "type": "integer",
            "description": "When the note was last updated. May differ from updated_time as the user can set it."
          }
        }
      },
      "Folder": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "description": "The folder title."
          },
          "parent_id": {
            "type": "string",
            "description": "ID of the parent notebook, empty for a top-level notebook."
          },
          "created_time": {
            "type": "integer",
            "description": "When the folder was created."
          },
          "updated_time": {
            "type": "integer",
            "description": "When the folder was last updated."
          },
          "user_created_time": {
            "type": "integer",
            "description": "When the folder was created. May differ from created_time as the user can set it."
          },
          "user_updated_time": {
            "type": "integer",
            "description": "When the folder was last updated. May differ from updated_time as the user can set it."
          },
          "is_shared": {
            "type": "integer"
          }
        }
      },
      "Tag": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "description": "The tag title."
          },
          "created_time": {
            "type": "integer",
            "description": "When the tag was created."
          },
          "updated_time": {
            "type": "integer",
            "description": "When the tag was last updated."
          },
          "user_created_time": {
            "type": "integer",
            "description": "When the tag was created. May differ from created_time as the user can set it."
          },
          "user_updated_time": {
            "type": "integer",
            "description": "When the tag was last updated. May differ from updated_time as the user can set it."
          }
        }
      }
    }
  },
  "security": [
    {
      "token": []
    }
  ]
}