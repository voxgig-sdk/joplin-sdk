# BasicTagFlow

main: kit: flow: BasicTagFlow:
{
  entity: "tag",
  kind: "basic",
  name: "BasicTagFlow",
  step: [
    {
      input: {
        ref: "tag_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "tag_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "tag_ref01",
        srcdatavar: "tag_ref01_data",
        suffix: "_up0",
        textfield: "title"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-tag_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "tag_ref01",
        srcdatavar: "tag_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "tag01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-tag_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "tag_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "tag01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "tag_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicTagFlow"
}