# BasicNoteFlow

main: kit: flow: BasicNoteFlow:
{
  entity: "note",
  kind: "basic",
  name: "BasicNoteFlow",
  step: [
    {
      input: {
        ref: "note_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "note_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "note_ref01",
        srcdatavar: "note_ref01_data",
        suffix: "_up0",
        textfield: "author"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-note_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "note_ref01",
        srcdatavar: "note_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "note01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-note_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "note_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "note01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "note_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicNoteFlow"
}